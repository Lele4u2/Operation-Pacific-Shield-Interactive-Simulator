import { getObjectiveById, getSiteById, pushLog, pushMessage } from './state.js';

export function requestRFI(state, siteId, description) {
  const site = getSiteById(state, siteId);
  if (!site) throw new Error('Unknown site');

  const hasRfi = state.rfis.some((entry) => entry.siteId === siteId && entry.status === 'PENDING');
  if (hasRfi) throw new Error('An RFI for this site is already pending.');

  const rfi = {
    id: `RFI-${Date.now()}`,
    siteId,
    description,
    status: 'PENDING',
    result: 'Awaiting response from CAOC',
  };

  state.rfis.push(rfi);
  pushLog(state, `MOB requested information for ${site.name}: ${description}`);
  pushMessage(state, `RFI submitted to CAOC: ${description}`, 'MOB');

  const objective = getObjectiveById(state, state.selectedObjectiveId);
  if (objective) {
    const req = objective.requirements.find((item) => item.id === 'rfi');
    if (req) req.satisfied = true;
  }

  return rfi;
}

export function assignResource(state, resourceId, qty = 1, toSiteId = 'fos-lantern') {
  const resource = state.resources.available.find((item) => item.id === resourceId);
  if (!resource) throw new Error('Unknown resource');
  if (qty < 1) throw new Error('Resource quantity must be greater than zero.');
  if (resource.qty < qty) throw new Error('Not enough resource available to assign.');

  if (!state.resources.atSite[toSiteId]) {
    state.resources.atSite[toSiteId] = {};
  }

  state.resources.atSite[toSiteId][resourceId] = (state.resources.atSite[toSiteId][resourceId] || 0) + qty;
  resource.qty -= qty;

  state.assignments.push({
    id: `ASSIGN-${Date.now()}`,
    siteId: toSiteId,
    resourceId,
    qty,
    status: 'COMMITTED',
  });

  pushLog(state, `Resource assigned: ${qty} ${resource.name} to ${toSiteId}.`);
  if (resourceId === 'fuel-truck') {
    const objective = getObjectiveById(state, state.selectedObjectiveId);
    const fuelReq = objective?.requirements.find((item) => item.id === 'fuel');
    if (fuelReq) fuelReq.satisfied = true;
  }

  return state.assignments[state.assignments.length - 1];
}

export function approveTask(state, station = 'CAOC') {
  const objective = getObjectiveById(state, state.selectedObjectiveId);
  if (!objective) throw new Error('Mission objective missing');

  const fuelReq = objective.requirements.find((item) => item.id === 'fuel');
  const rfiReq = objective.requirements.find((item) => item.id === 'rfi');
  if (!fuelReq?.satisfied || !rfiReq?.satisfied) {
    throw new Error('You must complete required RFI and resource checks before CAOC approval.');
  }

  const caocReq = objective.requirements.find((item) => item.id === 'caoc');
  if (caocReq) caocReq.satisfied = true;

  const site = getSiteById(state, 'fos-lantern');
  if (site) {
    site.readiness = Math.min(site.readiness + 25, 100);
    site.status = 'Prepared';
  }

  pushLog(state, `${station} approved the support package for FOS LANTERN.`);
  pushMessage(state, 'CAOC approved the support package. FOS sustainment is now coordinated.', 'CAOC');
  return true;
}

export function resolveTurn(state) {
  const objective = getObjectiveById(state, state.selectedObjectiveId);
  if (!objective) throw new Error('No objective selected');

  const allMet = objective.requirements.every((requirement) => requirement.satisfied);
  if (!allMet) {
    throw new Error('Mission conditions are incomplete. Complete the objective requirements before resolving the turn.');
  }

  const site = getSiteById(state, 'fos-lantern');
  if (site) {
    site.readiness = 100;
    site.status = 'Ready';
  }

  objective.status = 'COMPLETE';
  state.status = 'COMPLETE';
  state.phase = 'ASSESSMENT';
  state.debrief = {
    title: 'Mission complete: FOS LANTERN established',
    summary: 'The access issue was resolved, fuel was allocated, and CAOC approval was secured.',
    score: 95,
    results: [
      'RFI acknowledged and acted upon.',
      'Fuel truck assigned and committed to the objective.',
      'FOS LANTERN readiness increased to 100%.',
    ],
  };

  const req = objective.requirements.find((item) => item.id === 'submit');
  if (req) req.satisfied = true;

  pushLog(state, 'Turn resolved. Objective complete. FOS LANTERN is now established.');
  pushMessage(state, 'Mission complete. Forward operating site readiness is 100%.', 'GM');

  return state.debrief;
}

export function completeTurn(state) {
  if (!state.status || state.status === 'COMPLETE') {
    throw new Error('Mission is already resolved.');
  }

  const objective = getObjectiveById(state, state.selectedObjectiveId);
  if (!objective) throw new Error('Objective not found');

  const allRequirements = objective.requirements.every((requirement) => requirement.satisfied);
  if (!allRequirements) {
    throw new Error('Not all required actions for the objective are satisfied.');
  }

  return resolveTurn(state);
}

export function advanceTurn(state) {
  if (state.status === 'COMPLETE') return state;
  state.turn += 1;
  state.phase = state.turn % 2 === 0 ? 'COORDINATION' : 'PLANNING';
  pushLog(state, `Turn advanced to ${state.turn}. Phase: ${state.phase}.`);
  return state;
}
